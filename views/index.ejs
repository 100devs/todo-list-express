<!DOCTYPE html> <!-- Telling the browser that the document is HTML -->
<html lang="en"> <!-- Start of HTML tag, Setting the default language for HTML document to be English -->

<head> <!-- Starting the head tag where the metadata is stored -->
    <meta charset="UTF-8"> <!-- Indicates what character set should be used -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge"> <!-- Sets appropriate compatibility for MS browsers -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Sets the width of available viewing area to be the width of the device screen -->
    <title>Document</title> <!-- assigns a title appears on the browser tab -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <!-- linking to the Font Awesome icons library  -->
    <link rel="stylesheet" href="css/style.css"> <!-- linking to the local style sheet inside the public folder -->
</head> <!-- closing of head tag -->

<body> <!-- main content that displays on the browser -->
    <!DOCTYPE html> <!--This is a typo-->
    <html lang="en"> <!--This is a typo-->

    <head> <!--This is a typo-->
        <meta charset="UTF-8"> <!--This is a typo-->
        <meta http-equiv="X-UA-Compatible" content="IE=edge"> <!--This is a typo-->
        <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--This is a typo-->
        <title>Document</title> <!--This is a typo-->
    </head> <!--This is a typo-->

    <body>
        <h1>Todo List: </h1> <!--This is the main title of the page-->
        <ul class="todoItems"> <!-- create unordered list and assign todoItems class -->
            <% for(let i=0; i < items.length; i++) {%> <!-- use ejs to start a for loop -->
                <li class="item"> <!-- creating a list item with a class of item -->
                    <% if(items[i].completed===true) {%>
                        <!-- to check if an item in an array with completed property is true or not true -->
                        <span class='completed'>
                            <%= items[i].thing %>
                        </span>
                        <!-- creating an inline element with class of completed, adding EJS to display the name of a task -->
                        <% }else{ %> <!-- EJS for else clause of the if statement -->
                            <span>
                                <%= items[i].thing %>
                            </span> <!-- creating an inline element and display the task with NO CLASS -->
                            <% } %> <!-- EJS to close the Else Statement -->
                                <span class='fa fa-trash'></span>
                                <!-- Display Font Awesome Icon of trash can inside a span -->
                </li> <!-- Closing our list item -->
                <% } %> <!-- EJS to close the for loop -->
        </ul> <!-- Closing the unordered list -->

        <h2>Left to do: <%= left %>
        </h2>
        <!-- Creates a second level heading tag with text and using EJS to display a variable showing how many tasks are left to complete -->

        <h2>Add A Todo:</h2> <!-- Create a second level header -->

        <form action="/addTodo" method="POST"> <!-- Create a form with a POST method that goes to the /addTodo route -->
            <input type="text" placeholder="Thing To Do" name="todoItem">
            <!-- create an input box that accepts text with default text before we type and giving a unique name for later reference  -->
            <input type="submit"> <!-- it gives the form a submit button -->
        </form> <!-- closing the form tag-->


        <script src='js/main.js'></script>
        <!-- links to the main.js file located inside the js folder, which is inside the public folder -->
    </body> <!-- Closing the body tag -->

    </html> <!-- Closing the html tag -->