<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    />
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Document</title>
      </head>
      <body>
        <!-- heading 1 -->
        <h1>Todo List:</h1>
        <!-- unordered list of todo items -->
        <ul class="todoItems">
          <!-- loops through the items array passed from the server -->
          <% for(let i = 0; i < items.length; i++) {%>
          <!-- for each li that has the completed property === true, add the completed class -->
          <li class="item">
            <% if(items[i].completed === true) {%><span class="completed"
              ><%= items[i].thing %></span
            >
            <!-- if the li.completed !== true render the li normally -->
            <% }else{ %>
            <span><%= items[i].thing %></span>
            <% } %>
            <!-- add a trash icon -->
            <span class="fa fa-trash"></span>
          </li>
          <% } %>
        </ul>

        <!-- heading 2 - dynamically generates the number of yet to do items-->
        <h2>Left to do: <%= left %></h2>

        <h2>Add A Todo:</h2>

        <!-- form to add todos with POST -->
        <form action="/addTodo" method="POST">
          <input type="text" placeholder="Thing To Do" name="todoItem" />
          <input type="submit" />
        </form>

        <script src="js/main.js"></script>
      </body>
    </html>
  </body>
</html>
